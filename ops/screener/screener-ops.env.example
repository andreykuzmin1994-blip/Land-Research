# Copy to ~/.config/screener-ops.env on the server and edit.
# This file holds no secrets by default. Keep the real copy out of git:
# an ntfy topic name works like a password (anyone who knows it can read
# and post to it).

# Where the repository is checked out, and the branch the server runs.
REPO_DIR="$HOME/Land-Research"
BRANCH=main
PULL=1                       # fetch + fast-forward BRANCH before each run

# One settings file per county, space-separated, relative to REPO_DIR.
# Today only Fulton exists; add e.g. screener/settings-will.toml later.
COUNTIES="screener/settings.toml"

# Retry schedule after a failed run, in seconds (1 h, then 6 h).
RETRY_WAITS="3600 21600"
RUN_TIMEOUT=8h               # a single run longer than this counts as failed

# Alerts: an ntfy topic URL (install the ntfy app, subscribe to the same
# topic). Leave empty to only write ~/screener-ops/logs/alerts.log.
NTFY_URL=""                  # e.g. https://ntfy.sh/<long-random-topic-name>

# Claude hand-off when every retry fails. Claude runs as the separate
# FIX_USER (made by install.sh) on a plain copy of the code in FIX_DIR, so
# nothing it runs can reach this user's files, the checkout or its git.
# Needs Claude Code installed and logged in AS THAT USER (README.md).
CLAUDE_FIX=1
CLAUDE_BIN=/home/screener-fix/.local/bin/claude
CLAUDE_MODEL=""              # empty = Claude Code's default model
CLAUDE_TIMEOUT=45m
FIX_USER=screener-fix
FIX_DIR=/srv/screener-fix
FIX_PYTHON=/home/screener-fix/.venv/bin/python

# Push the proposed fix branch (screener-fix/*) to GitHub. Off by default:
# the fix then stays on the server. Turning it on needs a key with write
# access (FIX_SSH_KEY) and a branch-protection rule on main; see README.md.
FIX_PUSH=0
FIX_REMOTE=origin
FIX_SSH_KEY=""               # e.g. $HOME/.ssh/screener_fix_ed25519

# Lead checks: after a clean, plain run, two Claude agents read public
# documents about each new grade A (then B) lead, and the quote checker
# keeps only what it can re-fetch. OFF by default. Before turning it on:
# run "install.sh --lead-checks" as root, install and log in to Claude
# Code as screener-lead, and read "Lead checks" in README.md (what is sent
# to Anthropic and to the web, and what to verify on this server first).
INVESTIGATE=0
INVESTIGATE_MAX=5            # leads per county per run
INVESTIGATE_GRADES="A B"     # "A" to check only grade A
INVESTIGATE_TIMEOUT=40m      # each agent
INVESTIGATE_BUDGET=14400     # seconds for all lead checks of one run
INVESTIGATE_MAX_TRIES=2      # failed tries before a lead is left alone
INVESTIGATE_MAX_TURNS=""     # passed to claude as --max-turns when set
LEAD_USER=screener-lead
LEAD_DIR=/srv/screener-lead
LEAD_CLAUDE_BIN=/home/screener-lead/.local/bin/claude
LEAD_MODEL=""                # empty = Claude Code's default model
CHECK_USER=screener-check
CHECK_DIR=/srv/screener-check
LEADS_DIR="$REPO_DIR/screener/leads"   # results; gitignored

STATE_DIR="$HOME/screener-ops"
LOG_KEEP_DAYS=90
